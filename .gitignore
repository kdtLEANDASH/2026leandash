# ==========================================
# 공통 (IDE, OS)
# ==========================================
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.swp
.classpath
.project
.settings/
bin/
out/

# ==========================================
# Backend (Spring Boot / Gradle)
# ==========================================
# 백엔드 폴더 내부의 빌드 결과물과 설정들
backend/.gradle/
backend/build/
backend/out/
backend/bin/
backend/.settings/
backend/.project/
backend/.classpath/

# 로컬 DB나 로그 파일 (있을 경우)
backend/*.log
backend/help.md
backend/src/main/resources/application-local.yaml
backend/src/main/resources/application-*.local.yaml

# ==========================================
# Frontend (React / Vite / Node)
# ==========================================
# 제일 중요한 놈 (절대 올리면 안 됨)
frontend/node_modules/

# 빌드 결과물 (배포용 파일들)
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# 환경 변수 파일 (보안상 절대 금지!)
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# npm 로그들
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Vite 설정 관련
frontend/.vite/

#bin 폴더 무시
bin/

# ESLint / Stylelint 캐시 파일
frontend/.eslintcache
frontend/.stylelintcache

# TypeScript 빌드 캐시 (TS 쓸 경우 은근 자주 생김)
frontend/*.tsbuildinfo

# 테스트 커버리지 결과물
frontend/coverage/

# Mac 사용자 빌드 찌꺼기 (혹시 모를)
frontend/.DS_Store


# 로컬 DB 파일 (H2 파일 모드 쓸 경우 깃허브에 올라가는 거 방지)
backend/*.h2.db
backend/*.mv.db
backend/*.trace.db

# 운영/보안용 yml (local 외에도 secret이나 prod 이름 들어간 건 다 막아버리기)
backend/src/main/resources/*-secret.yaml
backend/src/main/resources/*-secret.yml
backend/src/main/resources/*-prod.yaml
backend/src/main/resources/*-prod.yml

# yaml
src/main/resources/application.yaml